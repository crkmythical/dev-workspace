{
  "name": "secure-dev-workspace",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "cd packages/spa && bun run dev",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx biome check .",
    "format": "bunx biome format . --write",
    "build:spa": "cd packages/spa && bun run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/spa/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "bun-types": "^1.2.0",
    "typescript": "5.9.3"
  }
}
