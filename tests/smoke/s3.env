# Extra environment for the instance that backs up to an S3 endpoint (services/10-s3-backup.sh).
# Placeholders for a throwaway endpoint, not credentials. The address is the one that script gives
# its S3 server on the instance's network.
RESTIC_REPOSITORY=s3:http://172.30.82.30:9000/smoke-bucket
RESTIC_PASSWORD=smoke-s3-restic-pass
AWS_ACCESS_KEY_ID=smokekey
AWS_SECRET_ACCESS_KEY=smokesecret
