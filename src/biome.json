{
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "ignore": [
      "node_modules",
      "**/node_modules",
      "**/dist",
      "**/out",
      "*.tar",
      "bun.lock",
      "image/selkies-web",
      "rust",
      "**/*.min.js"
    ]
  }
}
