# Global options. The admin API (default 127.0.0.1:2019) is turned off: this Caddy runs a static
# Caddyfile under supervisord and never reloads live, so nothing needs the admin socket — and
# leaving it on lets any in-container process (e.g. a code-server terminal) reconfigure or stop the
# gateway, including stripping the auth gate. Off = one less loopback lever.
{
	admin off
}

:8080 {
	# RESPONSE HEADERS for everything this site serves, the backends' answers included (`defer`
	# applies them after the proxied response, and `?` leaves a header alone when the backend sets
	# its own, so code-server's and KasmVNC's own policies win). What they cannot be given a policy
	# for (code-server's workbench needs inline scripts and eval) stays without a CSP; the pages we
	# own get one below.
	#
	# One block PER header, on purpose: Caddy turns the `?` of a block into a requirement on the
	# whole block ("apply only if none of these headers is already set"), so in a single block one
	# header the backend sets (the /sync/ page sets X-Frame-Options itself) silently cancelled all
	# the others (measured). Separate blocks are independent.
	header {
		?X-Content-Type-Options nosniff
		defer
	}
	header {
		?X-Frame-Options SAMEORIGIN
		defer
	}
	header {
		?Referrer-Policy same-origin
		defer
	}
	header {
		# Browser features nothing here uses. The desktop streams NEED the others (fullscreen,
		# pointer lock, clipboard, microphone, keyboard lock), so they are not listed.
		?Permissions-Policy "geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), camera=()"
		defer
	}
	header {
		-Server
		defer
	}
	# HSTS only for a request that came in over HTTPS: the edge says so in X-Forwarded-Proto and, for
	# Cloudflare, CF-Visitor. Browsers ignore it on plain HTTP, but there is no point sending a
	# promise we cannot keep. (Caddy overwrites X-Forwarded-Proto for the services BEHIND it, since
	# the client in front is not a trusted proxy, so the gate reads CF-Visitor for the cookie.)
	@https_xfp header X-Forwarded-Proto https
	header @https_xfp Strict-Transport-Security "max-age=31536000"
	@https_cf header_regexp scheme CF-Visitor `"scheme"\s*:\s*"https"`
	header @https_cf Strict-Transport-Security "max-age=31536000"

	# UNIFIED AUTH GATEWAY (see deploy/docs/design-unified-auth-gateway.md).
	# Deny-by-default: ONE session-cookie check sits in front of every route, HTTP and WebSocket
	# alike. A same-origin cookie rides the WS upgrade handshake (Basic Auth cannot), so the single
	# gate covers code-server, KasmVNC and Selkies WebSockets uniformly — backends no longer each
	# guard themselves at the perimeter. `route` makes the directives run in the written order.
	route {
		# --- Public allowlist (NOT gated) ---
		# /auth/* is the login surface (must be reachable to log in). /sync/api/destruct is
		# break-glass: remote self-destruct must work precisely when normal access is lost, and it
		# authenticates itself with the destruct passphrase.
		handle /auth/* {
			reverse_proxy 127.0.0.1:8081
		}
		handle /sync/api/destruct {
			reverse_proxy 127.0.0.1:8081
		}

		# --- The gate ---
		# forward_auth asks the always-on sync-service whether the request carries a valid session
		# (the cookie it set at login). 2xx → fall through to the backends below; 401 → browsers are
		# redirected to the login page, WS upgrades simply fail (correct). Everything past this point
		# is unreachable until it passes, so a mis-edited route is CLOSED, not exposed.
		forward_auth 127.0.0.1:8081 {
			uri /auth/verify
			@denied status 401
			handle_response @denied {
				redir * /auth/login?next={http.request.orig_uri}
			}
		}

		# --- Protected backends (reached only after the gate passes) ---
		# Remote desktop(s): per-stack snippets provisioned at build time into /etc/caddy/desktop.d/
		#   selkies → /desktop/ (+ WS /desktop/api/websockets)   kasmvnc → /vnc/ (+ WS /websockify)
		# The backends have no login of their own; this gate is the only one.
		import /etc/caddy/desktop.d/*.caddy

		# Sync: API proxied to the daemon, SPA served from dist. doctor is no longer specially
		# gated — the session gate covers it (and everything) now.
		handle /sync/api/* {
			reverse_proxy 127.0.0.1:8081
		}
		handle_path /sync/* {
			# The sync page is Rust/WebAssembly. Only same-origin modules and Wasm compilation are
			# allowed; there is no inline application script or third-party origin.
			header Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			header X-Frame-Options DENY
			header Cache-Control "no-cache"
			root * /opt/sdw-web
			file_server
		}

		# Editor landing route selected at build time. code-server proxies to :8082; `none`
		# redirects to the authenticated Rust/Wasm sync page instead of a dead backend.
		import /etc/caddy/editor.d/*.caddy
	}
}
