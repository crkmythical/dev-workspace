# Clash (mihomo) configuration template, owned by the image (/usr/share/sdw/clash/).
#
# `sdw` renders it into /etc/clash/config.yaml at start-up (entrypoint), by `setup`, by
# `set-clash-dns` and by `sdw proxy-only` (the standalone client). The rendered file holds the
# subscription URL and the controller secret, so it is mode 0600 and owned by the clash user, and it
# is overwritten at every start: change this template (in the image), not the rendered file.
#
# The renderer refuses a template that lacks one of its four placeholders (core/src/egress/domain.rs):
# the subscription URL, the DNS nameserver list, the controller secret and the allow-lan flag.
# Routing is declared here (mode rule, one MATCH rule), never selected at run time.

mixed-port: 7890
socks-port: 7891
# false: Clash listens on loopback only (the workspace). The standalone client renders true, so the
# container port it publishes on the host's loopback can reach Clash.
allow-lan: {{CLASH_ALLOW_LAN}}
bind-address: "*"
mode: rule
log-level: warning
# The controller can re-route or reconfigure Clash, so it demands a secret that only the clash user
# and root can read (they are the config file's readers). Loopback only, in every rendering.
external-controller: 127.0.0.1:9090
secret: "{{CLASH_CONTROLLER_SECRET}}"
unified-delay: true
tcp-concurrent: true

dns:
  enable: true
  listen: 127.0.0.1:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  nameserver:
{{CLASH_DNS_NAMESERVER}}

proxy-providers:
  subscription:
    type: http
    url: "{{CLASH_SUBSCRIPTION_URL}}"
    interval: 3600
    proxy: DIRECT
    path: ./providers/subscription.yaml
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204
      interval: 180

proxy-groups:
  - name: auto-select
    type: url-test
    # REJECT is listed first on purpose. A group with NO members (a subscription that lists no
    # nodes, or whose nodes are all filtered out) gets mihomo's implicit COMPATIBLE member, which
    # is DIRECT: every request would then leave the box unproxied while the probe still passed
    # (measured). With REJECT in the list an empty group refuses instead, and any alive node
    # outranks it as soon as there is one.
    proxies:
      - REJECT
    include-all-providers: true
    exclude-type: direct
    exclude-filter: "优选域名|IPv6优选"
    url: http://www.gstatic.com/generate_204
    interval: 180
    tolerance: 100

rules:
  - MATCH,auto-select
