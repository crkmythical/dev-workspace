# Environment of the smoke-test workspace. Placeholders for a throwaway container, not credentials.
# (CLASH_SUBSCRIPTION_URL and TUNNEL_HOST_PORT are set by docker-compose.smoke.yml.)
PASSWORD=smoke-master-pass-123
SYNC_ENABLED=1
REMOTE_DESTRUCT_ENABLED=1
PENTEST_VAULT_PASSWORD=smoke-pentest-pass-456
# The egress firewall is on by default. The checks other than 72-egress-enforce talk to helper
# containers (sshd, MinIO, a git server, the fake upstream) directly, so they run without it;
# 72-egress-enforce starts an instance of its own with the flag left at its default.
EGRESS_ENFORCE=0
# Backup to a local restic repository (inside the container): exercises the whole watcher.
RESTIC_REPOSITORY=/var/lib/smoke-restic/repo
RESTIC_PASSWORD=smoke-restic-pass
AWS_ACCESS_KEY_ID=smoke
AWS_SECRET_ACCESS_KEY=smoke
# Ciphertext replication to a bare repository that the checks create inside the container.
VAULT_GIT_REPO=/srv/smoke-remote.git
