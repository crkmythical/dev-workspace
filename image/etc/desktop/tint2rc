# tint2 panel configuration for dev-workspace remote desktop.
# Bottom taskbar with system tray and clock.

# Panel
panel_items = TSC
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 4 0 4
panel_position = bottom center horizontal
panel_background_id = 1
panel_layer = top
panel_monitor = all

# Backgrounds
rounded = 0
border_width = 0
background_color = #1e1e2e 90
border_color = #45475a 100

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 2 2
taskbar_background_id = 0
taskbar_active_background_id = 0

# Task
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 200 32
task_padding = 4 2 4
task_font = DejaVu Sans 10
task_font_color = #cdd6f4 100
task_active_font_color = #89b4fa 100
task_background_id = 0
task_active_background_id = 0

# System tray
systray_padding = 4 2 4
systray_background_id = 0
systray_icon_size = 20

# Clock
time1_format = %H:%M
time1_font = DejaVu Sans Bold 10
clock_font_color = #a6adc8 100
clock_padding = 8 0
clock_background_id = 0
