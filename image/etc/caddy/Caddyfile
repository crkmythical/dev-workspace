:8080 {
	# --- Remote desktop(s) (stack-specific routing) ---
	# Per-stack snippets are provisioned at build time into /etc/caddy/desktop.d/
	# based on DESKTOP_STACK:
	#   selkies  → desktop-selkies.caddy  (serves /desktop/, WS /desktop/websockets)
	#   kasmvnc  → desktop-vnc.caddy      (serves /vnc/,     WS /vnc/websockify)
	#   both     → both snippets active simultaneously
	# All bind 127.0.0.1 and sit behind the shared $DESKTOP_BCRYPT_HASH auth.
	import /etc/caddy/desktop.d/*.caddy

	# --- Sync service ---
	handle /sync/* {
		reverse_proxy 127.0.0.1:8081
	}

	# --- code-server (default) ---
	handle {
		reverse_proxy 127.0.0.1:8082
	}
}
