:8080 {
	# --- Remote desktop (stack-specific routing) ---
	# The desktop block is provisioned at build time based on DESKTOP_STACK:
	#   selkies  → Caddy serves static client + reverse-proxies WS /desktop/websockets
	#   kasmvnc  → Caddy reverse-proxies everything under /desktop to KasmVNC
	# Both bind 127.0.0.1:6080 and sit behind the shared $DESKTOP_BCRYPT_HASH auth.
	import /etc/caddy/desktop.caddy

	# --- Sync service ---
	handle /sync/* {
		reverse_proxy 127.0.0.1:8081
	}

	# --- code-server (default) ---
	handle {
		reverse_proxy 127.0.0.1:8082
	}
}
