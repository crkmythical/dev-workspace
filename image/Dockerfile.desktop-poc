# PoC: Validate KasmVNC on Docker Desktop macOS
# Build: docker build -f image/Dockerfile.desktop-poc -t desktop-poc .
# Run:   docker run --rm -p 6080:6080 desktop-poc
# Test:  Open http://localhost:6080 in browser
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    openbox \
    xterm \
    mesa-utils \
    libgl1-mesa-dri \
    libglib2.0-0 \
    dbus-x11 \
    fonts-noto-cjk \
    fonts-dejavu-core \
    x11-utils \
    x11-xserver-utils \
    curl \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install KasmVNC from GitHub releases
ARG KASMVNC_VERSION=1.3.3
RUN ARCH=$(dpkg --print-architecture) && \
    curl -fsSL "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_bookworm_${KASMVNC_VERSION}_${ARCH}.deb" \
    -o /tmp/kasmvnc.deb && \
    apt-get update && apt-get install -y --no-install-recommends /tmp/kasmvnc.deb && \
    rm -f /tmp/kasmvnc.deb && rm -rf /var/lib/apt/lists/*

# KasmVNC config
RUN mkdir -p /root/.vnc && \
    echo "network:" > /root/.vnc/kasmvnc.yaml && \
    echo "  interface: 0.0.0.0" >> /root/.vnc/kasmvnc.yaml && \
    echo "  websocket_port: 6080" >> /root/.vnc/kasmvnc.yaml && \
    echo "  use_ipv4: true" >> /root/.vnc/kasmvnc.yaml && \
    echo "security:" >> /root/.vnc/kasmvnc.yaml && \
    echo "  users:" >> /root/.vnc/kasmvnc.yaml && \
    echo "    user:" >> /root/.vnc/kasmvnc.yaml && \
    echo "      password: password" >> /root/.vnc/kasmvnc.yaml

ENV DISPLAY=:1

# Start script
RUN printf '#!/bin/bash\n\
Xvfb :1 -screen 0 1920x1080x24 &\n\
sleep 1\n\
openbox &\n\
kasmvncserver :1 -websocketPort 6080 -interface 0.0.0.0 -SecurityTypes None\n\
wait\n' > /start.sh && chmod +x /start.sh

EXPOSE 6080
CMD ["/start.sh"]
