# ============================================================
# Secure Dev Workspace — Environment Variables
# ============================================================
# Copy to `.env` and fill in. Only CLASH_SUBSCRIPTION_URL is required.
# Everything else is optional and can be configured later.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — container won't start without this
# ----------------------------------------------------------

# Clash-format proxy subscription URL
CLASH_SUBSCRIPTION_URL=https://cfnew.cicd.dpdns.org/372074d4-385f-4205-9071-7e61186dffd4/sub?target=clash

# ----------------------------------------------------------
# OPTIONAL — configure when ready, skip for quick start
# ----------------------------------------------------------

# Vault Git repo for auto-sync (HTTPS with token embedded, or SSH URL)
# Examples:
#   https://ghp_xxxx@github.com/user/dev-vault.git  (HTTPS + token, simplest)
#   git@github.com:user/dev-vault.git               (SSH, needs key in vault)
# Leave empty to disable auto-sync (you can still manually git push)
VAULT_GIT_REPO=

# Git identity (for vault-sync commits)
GIT_USER_NAME=
GIT_USER_EMAIL=

# Host port for Cloudflare Tunnel to connect to (default: 18080)
TUNNEL_HOST_PORT=18080

# code-server login password
# If empty, a random password is generated on first start (check: docker logs dev-workspace | grep password)
# For security, prefer leaving empty and checking logs, rather than storing in .env
PASSWORD=

# Vault auto-sync interval in seconds (default: 1800 = 30 min)
VAULT_SYNC_INTERVAL=1800

# Timezone (default: Asia/Shanghai)
TZ=Asia/Shanghai

# Docker memory reservation (default: 8g)
MEMORY_RESERVATION=8g

# ----------------------------------------------------------
# PENTEST ENVIRONMENT (optional — dual vault architecture)
# ----------------------------------------------------------

# Pentest vault password (for --auto mode only)
# In interactive mode, you'll be prompted
# PENTEST_VAULT_PASSWORD=

# ----------------------------------------------------------
# REMOTE DESKTOP (optional — KasmVNC)
# ----------------------------------------------------------

# Desktop resolution (default: 1920x1080)
DESKTOP_RESOLUTION=1920x1080
