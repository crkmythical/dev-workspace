# Secrets: the real configuration (master password, subscription URL, tokens) never goes in git.
# Start from .env.example; `make install-hooks` adds a guard against committing one by mistake.
.env

# File secrets for docker-compose.secrets.yml (make secrets-init)
secrets/
# Vault ciphertext (cloned separately)
vault-cipher/

# Dependencies
node_modules/

# Build output
dist/
out/

# Build artifacts
*.tar

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db

# Pre-downloaded build artifacts (local build acceleration)
src/image/*.tar.gz

# PoC / temporary files
.poc-tmp/

# Docker build cache
.docker/

# Cloudflare orchestration — API token secrets and typed per-instance state, never commit
deploy/orchestration/secrets.env
deploy/orchestration/instances/

# A smoke check writes the rotated password here for a moment (checks/66-rotation.sh).
src/tests/smoke/rotated-env.*
