# Copy to secrets.env (gitignored) and fill in. NEVER commit this; NEVER paste the token in chat.
# The scripts source this file, use it with curl, and never print the token.

# --- Cloudflare credentials ---
# Custom API token. Create at: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
#   -> Create Custom Token. Permissions (exactly these four):
#     Account | Cloudflare Tunnel        | Edit
#     Account | Access: Apps and Policies | Edit
#     Account | Access: Service Tokens    | Edit
#     Zone    | DNS                        | Edit
#   Account Resources: Include -> your account.   Zone Resources: Include -> your domain.
#   TTL: set a short expiry (e.g. end of today). Delete the token after the PoC.
CF_API_TOKEN=

# Account ID: dash.cloudflare.com -> any domain -> Overview -> right sidebar "Account ID"
CF_ACCOUNT_ID=

# Zone ID: the domain's Overview page -> right sidebar "Zone ID"
CF_ZONE_ID=

# Your apex domain, e.g. example.com  (instances live at inst-<id>.<WS_SUBDOMAIN>.<CF_ZONE_NAME>)
CF_ZONE_NAME=

# Base label for instance hostnames (default: ws)  ->  inst-abc.ws.example.com
WS_SUBDOMAIN=ws

# Email allowed to log in through the browser (Access "Allow" identity policy, email OTP)
ALLOW_EMAIL=
